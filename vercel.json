{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static",
      "config": {
        "html": {
          "fallback": "index.html"
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/favicon-miami-luxe.svg",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/apple-touch-icon.svg",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}